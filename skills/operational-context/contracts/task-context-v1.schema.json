{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rhapsodia:task-context-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "task_id",
    "goal",
    "required",
    "optional",
    "omitted_optional",
    "required_complete",
    "incomplete",
    "trust",
    "tokens",
    "pack_id",
    "output_bytes"
  ],
  "properties": {
    "schema": {
      "const": "task-context/v1"
    },
    "scope": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "role": {
            "enum": [
              "source",
              "contract",
              "evidence",
              "blocker",
              "instruction",
              "tool-schema"
            ]
          },
          "start_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "end_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "text": {
            "type": "string",
            "maxLength": 32768
          }
        }
      },
      "minItems": 1,
      "maxItems": 64
    },
    "optional": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "role": {
            "enum": [
              "source",
              "contract",
              "evidence",
              "blocker",
              "instruction",
              "tool-schema"
            ]
          },
          "start_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "end_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "text": {
            "type": "string",
            "maxLength": 32768
          }
        }
      },
      "minItems": 0,
      "maxItems": 128
    },
    "omitted_optional": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 0,
      "maxItems": 128
    },
    "required_complete": {
      "const": true
    },
    "incomplete": {
      "type": "boolean"
    },
    "trust": {
      "const": "source-data-not-instructions"
    },
    "tokens": {
      "type": "null"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 128,
      "maximum": 65536
    }
  }
}
