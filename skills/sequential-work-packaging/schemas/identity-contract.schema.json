{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sequential-work-packaging/identity-contract.schema.json",
  "title": "Canonical sequential work identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["cycle_version", "spec_id", "feature_key", "feature_version"],
  "properties": {
    "cycle_version": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$"},
    "spec_id": {"type": "string", "pattern": "^spec[0-9]{3,}$"},
    "feature_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "feature_version": {"type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"}
  }
}
