{
  "$id": "urn:nomia-mago-magia:live-routing-result:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "additionalProperties": false,
      "properties": {
        "live_routing_measured": {
          "type": "boolean"
        },
        "precision_recall_supported": {
          "type": "boolean"
        },
        "structural_corpus_validated": {
          "type": "boolean"
        }
      },
      "required": [
        "structural_corpus_validated",
        "live_routing_measured",
        "precision_recall_supported"
      ],
      "type": "object"
    },
    "confusion_matrix": {
      "type": "object"
    },
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ecosystem_release": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "evidence_kind": {
      "enum": [
        "live-model",
        "fixture"
      ]
    },
    "failures": {
      "type": "array"
    },
    "metrics": {
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name",
        "version",
        "host"
      ],
      "type": "object"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "expected_first_owner": {
            "type": "string"
          },
          "expected_owner_sequence": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "explanation_category": {
            "type": "string"
          },
          "handoff_sequence": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "mode_selected": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_first_owner": {
            "type": "string"
          },
          "observed_owner_sequence": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "category",
          "expected_first_owner",
          "observed_first_owner",
          "expected_owner_sequence",
          "observed_owner_sequence",
          "mode_selected",
          "handoff_sequence",
          "explanation_category",
          "passed"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "run_at": {
      "format": "date-time",
      "type": "string"
    },
    "scenario_count": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "skill_tree_hashes": {
      "additionalProperties": false,
      "properties": {
        "magia": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "mago": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "nomia": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "mago",
        "magia",
        "nomia"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "evidence_kind",
    "model",
    "run_at",
    "ecosystem_release",
    "corpus_sha256",
    "skill_tree_hashes",
    "scenario_count",
    "results",
    "confusion_matrix",
    "metrics",
    "failures",
    "claims"
  ],
  "title": "Nomia Mago Magia Live Routing Result",
  "type": "object"
}
