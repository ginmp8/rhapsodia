{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhapsodia.local/schemas/test-oracle-spec-v2.schema.json",
  "title": "Test Oracle Spec v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "oracle_id", "claim", "claim_type", "source_identity", "candidate_identity",
    "target_scope", "verification_write_scope", "protected_paths", "oracle_strategy", "oracle_origin",
    "quality", "observable", "execution", "nondeterminism", "evaluator_identity", "max_attempts"
  ],
  "properties": {
    "contract": {"const": "test-oracle-spec/v2"},
    "oracle_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["behavior", "authorization", "api-contract", "event-contract", "data-invariant", "migration", "concurrency", "idempotency", "retry", "cli", "ui-behavior", "security", "other"]},
    "source_identity": {"$ref": "#/$defs/identity"},
    "candidate_identity": {"$ref": "#/$defs/candidateIdentity"},
    "target_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verification_write_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "protected_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "oracle_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rationale", "assumptions", "blind_spots"],
      "properties": {
        "type": {"enum": ["specified", "invariant", "property", "model-based", "metamorphic", "differential", "statistical", "implicit"]},
        "rationale": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "blind_spots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "property": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "references": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decision_rule": {"type": "string", "minLength": 1},
        "model_identity": {"$ref": "#/$defs/identity"}
      }
    },
    "oracle_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "generator_identity", "independent_validation"],
      "properties": {
        "type": {"enum": ["human", "specification", "existing-test", "generated", "llm-assisted", "inferred"]},
        "generator_identity": {"type": "string", "minLength": 1},
        "independent_validation": {"type": "string"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soundness_assumptions", "completeness_limits", "strength_check", "strength_rationale"],
      "properties": {
        "soundness_assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "completeness_limits": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "strength_check": {"enum": ["not-required", "planned", "negative-control", "oracle-gap", "mutation"]},
        "strength_rationale": {"type": "string", "minLength": 1}
      }
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "input", "action", "expected", "failure_signal"],
      "properties": {
        "setup": {"type": "string", "minLength": 1},
        "input": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "failure_signal": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "mode", "requirements", "command_argv"],
      "properties": {
        "layer": {"enum": ["existing-focused-test", "integration-public-stack", "contract-boundary", "component-unit", "static"]},
        "mode": {"enum": ["design-only", "existing-test", "generated-test", "integration", "contract", "static"]},
        "requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "working_directory": {"type": "string", "minLength": 1},
        "command_argv": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "nondeterminism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "repetitions", "seed_policy", "order_policy", "clock_policy", "scheduler_policy"],
      "properties": {
        "mode": {"enum": ["deterministic", "controlled", "probabilistic"]},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
        "seed_policy": {"enum": ["fixed", "recorded", "not-applicable"]},
        "order_policy": {"enum": ["fixed", "systematic", "recorded", "not-applicable"]},
        "clock_policy": {"enum": ["controlled", "recorded", "real", "not-applicable"]},
        "scheduler_policy": {"enum": ["controlled", "systematic", "recorded", "default", "not-applicable"]},
        "statistical_rule": {"type": "string", "minLength": 1}
      }
    },
    "evaluator_identity": {"$ref": "#/$defs/identity"},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 100}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64}|vcs:.+|version:.+|declared:.+)$"},
    "candidateIdentity": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64}|vcs:.+|version:.+|declared:.+|unbound)$"}
  }
}
