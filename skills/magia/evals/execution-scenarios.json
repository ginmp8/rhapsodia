        "capture reproduction",
        "apply smallest fix",
        "run regression test"
      ]
    },
    {
      "id": "x003",
      "category": "ambiguous_bug",
      "profile": "standard",
      "input": "A bug is reported without a reliable reproduction.",
      "expected": [
        "do not patch speculative cause",
        "gather reproduction evidence or block honestly"
      ]
    },
    {
      "id": "x004",
      "category": "behavior_preserving_refactor",
      "profile": "standard",
      "input": "Refactor a module without changing behavior.",
