{
  "schema_version": 1,
  "frozen": true,
  "frozen_reason": "baseline for Magia execution architecture validation; mutate only as a separately approved evaluator-design change",
  "scenarios": [
    {
      "id": "x001",
      "category": "safe_change",
      "profile": "quick",
      "input": "Change one localized line with a reversible diff.",
      "expected": [
        "select quick unless a governed signal appears",
        "run a targeted check",
        "emit minimal evidence"
      ]
    },
    {
      "id": "x002",
      "category": "localized_bug_fix",
      "profile": "standard",
      "input": "Fix a reproducible parser defect.",
