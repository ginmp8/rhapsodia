{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/reproducibility-engineer/execution-environment.schema.json",
  "title": "Execution Environment and Provenance Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "run_id", "host", "runtime", "model", "tools", "dependencies", "locale", "timezone", "cache_policy", "concurrency_policy", "inputs", "outputs"],
  "properties": {
    "profile_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "os"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "configuration_identity"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "configuration_identity": {"type": "string", "minLength": 3}
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "identity"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string"},
          "identity": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "identity"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "identity": {"type": "string", "minLength": 1}
        }
      }
    },
    "locale": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "cache_policy": {"type": "string", "minLength": 1},
    "concurrency_policy": {"type": "string", "minLength": 1},
    "hermeticity": {"enum": ["recorded", "pinned", "hermetic"]},
    "controller_identity": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/digestedSubject"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/digestedSubject"}
    }
  },
  "$defs": {
    "digestedSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "sha256"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"}
      }
    }
  }
}
