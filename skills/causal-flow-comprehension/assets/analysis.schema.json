{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causal-flow-comprehension:analysis:1.0",
  "title": "Causal Flow Comprehension analysis v1",
  "description": "Typed structure only; semantic assertions require independent source review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question",
    "mode",
    "scope",
    "sources",
    "claims",
    "transitions",
    "checks",
    "gaps",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "understand",
        "challenge",
        "change-impact"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "inspected_paths",
        "closed_world",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "inspected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "closed_world": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "locator",
          "revision_or_context"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "config",
              "test-definition",
              "test-run",
              "trace",
              "log",
              "document",
              "user-report"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision_or_context": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status",
          "source_ids",
          "conditions",
          "universality",
          "countercheck"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CL-[0-9]{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "static-observed",
              "runtime-observed",
              "inferred",
              "hypothesis",
              "unknown"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-[0-9]{3}$"
            },
            "minItems": 0
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "universality": {
            "type": "string",
            "enum": [
              "local",
              "bounded",
              "unproven"
            ]
          },
          "countercheck": {
            "type": "string",
            "minLength": 0
          }
        }
      },
      "minItems": 0
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "trigger",
          "guard",
          "claim_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-[0-9]{3}$"
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "guard": {
            "type": "string",
            "minLength": 0
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CL-[0-9]{3}$"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "method",
          "status",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CHK-[0-9]{3}$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-[0-9]{3}$"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "why",
          "next_check"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-[0-9]{3}$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "next_check": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "verdict": {
      "type": "string",
      "enum": [
        "supported-within-scope",
        "contradicted",
        "insufficient-evidence"
      ]
    }
  }
}
