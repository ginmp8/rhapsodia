{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-graph:graph-query-v1",
  "title": "graph-query-v1",
  "type": "object",
  "required": [],
  "properties": {
    "operation": {
      "enum": [
        "search",
        "find",
        "node",
        "neighbors",
        "path",
        "impact",
        "subgraph",
        "stats",
        "aggregate",
        "timeline",
        "quality",
        "context"
      ]
    },
    "direction": {
      "enum": [
        "outgoing",
        "incoming",
        "both",
        "dependencies",
        "dependents"
      ]
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "max_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "accepted",
          "ambiguous",
          "stale"
        ]
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "enum": [
          "EXTRACTED",
          "DERIVED",
          "INFERRED",
          "MANUAL"
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "min_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "query": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "node": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "seed": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "target": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "property": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "group_by": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "metric": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "time_property": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "from": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "to": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "weight": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "detail": {
      "enum": [
        "compact",
        "evidence"
      ]
    },
    "budget_bytes": {
      "type": "integer",
      "minimum": 2048,
      "maximum": 1048576
    },
    "token_budget": {
      "type": "integer",
      "minimum": 512,
      "maximum": 262144
    },
    "max_edges": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "properties": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "\\S"
      }
    },
    "previous": {
      "type": "object",
      "required": [
        "schema_version",
        "graph_sha256",
        "profile_sha256",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "graph-context-receipt-v1"
        },
        "graph_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items": {
          "type": "object",
          "maxProperties": 2500,
          "propertyNames": {
            "pattern": "^(n:|e:)",
            "maxLength": 8192
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "const": "context"
          }
        }
      },
      "then": {
        "properties": {
          "max_nodes": {
            "maximum": 500
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "detail"
              ]
            },
            {
              "required": [
                "budget_bytes"
              ]
            },
            {
              "required": [
                "token_budget"
              ]
            },
            {
              "required": [
                "max_edges"
              ]
            },
            {
              "required": [
                "properties"
              ]
            },
            {
              "required": [
                "previous"
              ]
            }
          ]
        }
      }
    }
  ]
}
