{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-improver/stochastic-evaluation.schema.json",
  "title": "Skill Improver Stochastic Evaluation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_version", "metric", "runtime_identity", "cases"],
  "properties": {
    "evidence_version": {"const": 1},
    "metric": {
      "type": "object",
      "required": ["name", "direction", "binary"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "direction": {"enum": ["higher-is-better", "lower-is-better"]},
        "binary": {"type": "boolean"}
      }
    },
    "runtime_identity": {
      "type": "object",
      "required": ["no_skill", "parent", "candidate"],
      "properties": {
        "no_skill": {"type": "string", "minLength": 1},
        "parent": {"type": "string", "minLength": 1},
        "candidate": {"type": "string", "minLength": 1}
      }
    },
    "cases": {"type": "array", "minItems": 1}
  }
}
