{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-change-gate/gate-context.schema.json",
  "title": "Skill Change Gate Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_version",
    "claim_scope",
    "candidate_tree_sha256",
    "policy",
    "verifier",
    "evaluator",
    "evaluation_contract",
    "destination",
    "authority",
    "evidence",
    "waivers",
    "consumer_inventory_complete",
    "known_consumers"
  ],
  "properties": {
    "context_version": {"const": 1},
    "claim_scope": {"enum": ["local-acceptance", "promotion", "ecosystem-safe"]},
    "candidate_tree_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_tree_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_digest"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "version", "implementation_digest"],
      "properties": {
        "verifier_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "scenario_set_id", "evaluator_digest", "role", "candidate_had_access", "selection_informed_by_results", "exposure_generation_count"],
      "properties": {
        "evaluator_id": {"type": "string", "minLength": 1},
        "scenario_set_id": {"type": "string", "minLength": 1},
        "evaluator_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "role": {"enum": ["development", "selection", "holdout"]},
        "candidate_had_access": {"type": "boolean"},
        "selection_informed_by_results": {"type": "boolean"},
        "exposure_generation_count": {"type": "integer", "minimum": 0}
      }
    },
    "evaluation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holdout_required", "required_trials", "completed_trials", "independent_replication_required", "independent_replication_completed"],
      "properties": {
        "holdout_required": {"type": "boolean"},
        "required_trials": {"type": "integer", "minimum": 0},
        "completed_trials": {"type": "integer", "minimum": 0},
        "independent_replication_required": {"type": "boolean"},
        "independent_replication_completed": {"type": "boolean"}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "expected_identity", "observed_identity"],
      "properties": {
        "required": {"type": "boolean"},
        "expected_identity": {"type": ["string", "null"]},
        "observed_identity": {"type": ["string", "null"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expanded", "authorized", "added_surfaces"],
      "properties": {
        "expanded": {"type": "boolean"},
        "authorized": {"type": "boolean"},
        "added_surfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_type", "required", "status", "subject_candidate_tree_sha256", "producer_id", "producer_version", "policy_digest"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_type": {"enum": ["validator", "benchmark", "scenario", "receipt", "review", "runtime", "other"]},
          "required": {"type": "boolean"},
          "status": {"enum": ["pass", "fail", "blocked", "not-run"]},
          "subject_candidate_tree_sha256": {"$ref": "#/$defs/sha256"},
          "producer_id": {"type": "string", "minLength": 1},
          "producer_version": {"type": "string", "minLength": 1},
          "policy_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "notes": {"type": "string"}
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["waiver_id", "candidate_tree_sha256", "policy_digest", "finding_codes", "authorized_by", "reason", "single_use"],
        "properties": {
          "waiver_id": {"type": "string", "minLength": 1},
          "candidate_tree_sha256": {"$ref": "#/$defs/sha256"},
          "policy_digest": {"$ref": "#/$defs/sha256"},
          "finding_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authorized_by": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "expires_at": {"type": ["string", "null"]},
          "single_use": {"type": "boolean"}
        }
      }
    },
    "consumer_inventory_complete": {"type": "boolean"},
    "known_consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer_id", "contract_id", "status", "evidence_ref"],
        "properties": {
          "consumer_id": {"type": "string", "minLength": 1},
          "contract_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["compatible", "incompatible", "unverified"]},
          "evidence_ref": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
