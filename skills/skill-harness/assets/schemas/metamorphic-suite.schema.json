{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/skill-harness/metamorphic-suite.schema.json",
  "title": "Metamorphic Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "target_skill", "status", "groups"],
  "properties": {
    "suite_version": {"const": 1},
    "target_skill": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "measured"]},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "base_case_id", "relation", "variants"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "base_case_id": {"type": "string", "minLength": 1},
          "relation": {"enum": ["same-routing", "same-hard-gates", "same-core-semantics", "equivalent-outcome", "monotonic", "custom"]},
          "custom_relation": {"type": "string"},
          "evaluator_identity": {"type": "string"},
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "transformation"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "transformation": {"type": "string", "minLength": 1},
                "result": {"enum": ["pass", "fail", "not-run"]},
                "evidence_identity": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
