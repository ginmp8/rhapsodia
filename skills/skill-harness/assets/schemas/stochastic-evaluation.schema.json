{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/reproducibility-engineer/stochastic-evaluation.schema.json",
  "title": "Stochastic Evaluation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "scenario_id", "evaluator_identity", "reliability_k", "stop_rule", "claim", "evaluator", "trials"],
  "properties": {
    "profile_version": {"const": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "evaluator_identity": {"type": "string", "minLength": 1},
    "reliability_k": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 100}
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "max_trials"],
      "properties": {
        "type": {"enum": ["fixed-trials", "budget"]},
        "max_trials": {"type": "integer", "minimum": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "independent_replication"],
      "properties": {
        "level": {"enum": ["exploratory", "standard", "strong"]},
        "independent_replication": {"type": "boolean"}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["deterministic", "human", "llm-judge"]},
        "judge_identity": {"type": "string", "minLength": 1},
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["calibrated", "supplied", "unknown"]},
            "evidence_identity": {"type": "string"}
          }
        }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["success", "failure", "unknown"]},
          "result_identity": {"type": "string"}
        }
      }
    }
  }
}
