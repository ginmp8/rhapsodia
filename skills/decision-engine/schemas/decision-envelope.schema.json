{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentskills.example/decision-engine/decision-envelope-v2.schema.json",
  "title": "Decision Engine v2 Result",
  "type": "object",
  "required": [
    "contract_version",
    "materiality",
    "decision",
    "confidence",
    "evidence_refs",
    "rationale",
    "calibration",
    "next_action"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "decision-engine/2"},
    "decision_id": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "materiality": {"enum": ["low", "medium", "high"]},
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "question", "status", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "binary"},
            "question": {"type": "string", "minLength": 1},
            "status": {"enum": ["decided", "undetermined", "blocked", "escalate"]},
            "value": {"type": ["boolean", "null"]}
          }
        },
        {
          "type": "object",
          "required": ["type", "question", "status", "options", "options_exhaustive", "selected"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "choice"},
            "question": {"type": "string", "minLength": 1},
            "status": {"enum": ["decided", "undetermined", "blocked", "escalate"]},
            "options": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "options_exhaustive": {"type": "boolean"},
            "option_criteria": {
              "type": "object",
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "selected": {"type": ["string", "null"]}
          }
        },
        {
          "type": "object",
          "required": ["type", "question", "status", "scale", "score"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "score"},
            "question": {"type": "string", "minLength": 1},
            "status": {"enum": ["decided", "undetermined", "blocked", "escalate"]},
            "scale": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["kind", "levels"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {"const": "ordinal"},
                    "levels": {
                      "type": "array",
                      "minItems": 2,
                      "uniqueItems": true,
                      "items": {"type": "string", "minLength": 1}
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind", "min", "max", "meaning"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {"const": "numeric"},
                    "min": {"type": "number"},
                    "max": {"type": "number"},
                    "meaning": {"type": "string", "minLength": 1},
                    "unit": {
                      "anyOf": [
                        {"type": "string", "minLength": 1},
                        {"type": "null"}
                      ]
                    }
                  }
                }
              ]
            },
            "score": {"type": ["number", "null"]}
          }
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "object",
          "required": ["level", "basis"],
          "additionalProperties": false,
          "properties": {
            "level": {"enum": ["low", "medium", "high"]},
            "basis": {"type": "string", "minLength": 1}
          }
        },
        {"type": "null"}
      ]
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rationale": {"type": "string", "minLength": 1},
    "calibration": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "none"}}
        },
        {
          "type": "object",
          "required": ["kind", "value", "source", "calibration_ref"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "calibrated_probability"},
            "value": {"type": "number", "minimum": 0, "maximum": 1},
            "source": {"type": "string", "minLength": 1},
            "calibration_ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "next_action": {"type": ["string", "null"]}
  }
}
