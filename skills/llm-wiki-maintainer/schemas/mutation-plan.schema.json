{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llm-wiki-maintainer:mutation-plan:1",
  "title": "LLM Wiki mutation plan",
  "type": "object",
  "required": ["transaction_version", "operation", "schema_version", "source_ids", "writes"],
  "properties": {
    "transaction_version": {"const": 1},
    "operation": {"enum": ["initialize", "ingest", "query-persist", "lint", "schema-change", "repair"]},
    "schema_version": {"type": "string"},
    "source_ids": {"type": "array", "items": {"pattern": "^sha256:[0-9a-f]{64}$"}, "uniqueItems": true},
    "writes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "expected_before_sha256"],
        "properties": {
          "path": {"type": "string"},
          "expected_before_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "deletes": {"type": "array"}
  },
  "additionalProperties": false
}
