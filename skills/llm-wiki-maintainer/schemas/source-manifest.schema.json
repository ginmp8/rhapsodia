{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llm-wiki-maintainer:source-manifest:1",
  "title": "LLM Wiki source manifest",
  "type": "object",
  "required": ["manifest_version", "state_schema_version", "paths", "sources"],
  "properties": {
    "manifest_version": {"const": 1},
    "state_schema_version": {"const": "llm-wiki-state/1"},
    "paths": {"type": "object"},
    "sources": {"type": "object"}
  },
  "additionalProperties": false
}
