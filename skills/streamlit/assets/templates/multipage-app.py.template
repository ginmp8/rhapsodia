"""Modern programmatic multipage Streamlit starter.

Use this template only after resolving the target project's Streamlit version and
confirming that st.navigation and st.Page are available. For older pinned apps,
preserve their compatible navigation pattern instead of forcing an upgrade.
Keep page files under app_pages/ as direct Streamlit scripts and put shared
business logic, data access, and authorization in normal Python modules.
"""

import streamlit as st

st.set_page_config(page_title="{{APP_TITLE}}", layout="wide")
st.session_state.setdefault("initialized", True)

pages = [
    st.Page("app_pages/home.py", title="Home", icon=":material/home:"),
    st.Page("app_pages/analytics.py", title="Analytics", icon=":material/analytics:"),
]

navigation = st.navigation(pages)
navigation.run()
