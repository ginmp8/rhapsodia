{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhapsodia.local/schemas/workflow-plan-v2.schema.json",
  "title": "RhapsodIA Workflow Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "workflow_id",
    "objective",
    "success_criteria",
    "strategy",
    "authority",
    "stages",
    "budgets",
    "termination",
    "capabilities",
    "evidence",
    "checkpoints",
    "gates",
    "promotion"
  ],
  "properties": {
    "contract": {
      "const": "workflow-plan/v2"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strategy": {
      "const": "gated-convergence"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "allowed_effects",
        "forbidden_effects",
        "write_scope"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "allowed_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read-only",
              "mutating",
              "external-side-effect"
            ]
          }
        },
        "forbidden_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read-only",
              "mutating",
              "external-side-effect"
            ]
          }
        },
        "write_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "work_source",
          "depends_on",
          "max_parallel",
          "isolation",
          "effects",
          "read_set",
          "write_set",
          "success",
          "on_failure"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "single",
              "parallel",
              "pipeline",
              "verify",
              "synthesize",
              "loop"
            ]
          },
          "work_source": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_parallel": {
            "type": "integer",
            "minimum": 1
          },
          "isolation": {
            "enum": [
              "shared-readonly",
              "fresh-context",
              "workspace",
              "process",
              "host-native",
              "serial"
            ]
          },
          "effects": {
            "enum": [
              "read-only",
              "mutating"
            ]
          },
          "read_set": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "write_set": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "success": {
            "type": "string",
            "minLength": 1
          },
          "on_failure": {
            "enum": [
              "stop",
              "continue-independent",
              "retry",
              "repair",
              "escalate"
            ]
          },
          "max_iterations": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_workers",
        "max_parallel",
        "max_retries_per_unit",
        "max_reentries",
        "max_checkpoints",
        "max_checkpoint_repairs"
      ],
      "properties": {
        "max_workers": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries_per_unit": {
          "type": "integer",
          "minimum": 0
        },
        "max_reentries": {
          "type": "integer",
          "minimum": 0
        },
        "max_checkpoints": {
          "type": "integer",
          "minimum": 1
        },
        "max_checkpoint_repairs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success_predicate",
        "terminal_states"
      ],
      "properties": {
        "success_predicate": {
          "type": "string",
          "minLength": 1
        },
        "terminal_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "completed",
              "blocked",
              "escalated",
              "failed",
              "budget_exhausted"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional",
        "degradation"
      ],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "degradation": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "serial",
              "blocked",
              "not-run"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_identity",
        "planner_identity",
        "evaluator_identity"
      ],
      "properties": {
        "input_identity": {
          "type": "string",
          "minLength": 1
        },
        "planner_identity": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_identity": {
          "type": "string",
          "minLength": 1
        },
        "reference_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "required",
          "isolation",
          "evaluator_identity",
          "on_failure",
          "rerun_after_repair",
          "max_attempts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "behavior",
              "executable-proof",
              "adversarial-review",
              "perceptual",
              "human-approval",
              "custom"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "isolation": {
            "enum": [
              "same-context",
              "fresh-context",
              "workspace",
              "process",
              "host-native",
              "human"
            ]
          },
          "evaluator_identity": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "on_failure": {
            "enum": [
              "repair",
              "stop",
              "escalate",
              "recapture"
            ]
          },
          "rerun_after_repair": {
            "type": "boolean"
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "depends_on",
          "producer_stage",
          "gate_ids",
          "success"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "producer_stage": {
            "type": "string",
            "minLength": 1
          },
          "gate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "success": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_all_required_gates",
        "next_checkpoint_requires_promoted_dependencies",
        "accepted_feedback_only"
      ],
      "properties": {
        "requires_all_required_gates": {
          "const": true
        },
        "next_checkpoint_requires_promoted_dependencies": {
          "const": true
        },
        "accepted_feedback_only": {
          "const": true
        }
      }
    }
  }
}
