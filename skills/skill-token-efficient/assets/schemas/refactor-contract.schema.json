{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-token-efficient/refactor-contract.schema.json",
  "title": "Skill Token Efficient Refactor Contract",
  "type": "object",
  "required": ["contract_version", "tokenization", "semantic_invariants", "protected"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "tokenization": {
      "type": "object",
      "required": ["method"],
      "properties": {"method": {"type": "string", "minLength": 1}, "scope": {"enum": ["entrypoint", "instructions", "all-text"]}},
      "additionalProperties": true
    },
    "semantic_invariants": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "category", "statement", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["activation", "scope", "safety", "validation", "evidence", "compatibility", "output_contract", "readability", "progressive_loading", "other"]},
          "statement": {"type": "string", "minLength": 1},
          "verification": {"enum": ["contains", "regex", "local_reference", "manual", "scenario"]},
          "pattern": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "scenario_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "protected": {
      "type": "object",
      "required": ["urls", "paths", "commands", "env_vars", "schemas", "flags", "proper_nouns", "versions", "numbers"],
      "additionalProperties": false,
      "properties": {
        "urls": {"type": "array", "items": {"oneOf":[{"type":"string"},{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":1},"equivalents":{"type":"array","items":{"type":"string","minLength":1}},"authorized":{"type":"boolean"},"reason":{"type":"string"}},"additionalProperties":true}]}},
        "paths": {"type": "array", "items": {"oneOf":[{"type":"string"},{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":1},"equivalents":{"type":"array","items":{"type":"string","minLength":1}},"authorized":{"type":"boolean"},"reason":{"type":"string"}},"additionalProperties":true}]}},
        "commands": {"type": "array", "items": {"oneOf":[{"type":"string"},{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":1},"equivalents":{"type":"array","items":{"type":"string","minLength":1}},"authorized":{"type":"boolean"},"reason":{"type":"string"}},"additionalProperties":true}]}},
        "env_vars": {"type": "array", "items": {"oneOf":[{"type":"string"},{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":1},"equivalents":{"type":"array","items":{"type":"string","minLength":1}},"authorized":{"type":"boolean"},"reason":{"type":"string"}},"additionalProperties":true}]}},
        "schemas": {"type": "array", "items": {"oneOf":[{"type":"string"},{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":1},"equivalents":{"type":"array","items":{"type":"string","minLength":1}},"authorized":{"type":"boolean"},"reason":{"type":"string"}},"additionalProperties":true}]}},
        "flags": {"type": "array", "items": {"oneOf":[{"type":"string"},{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":1},"equivalents":{"type":"array","items":{"type":"string","minLength":1}},"authorized":{"type":"boolean"},"reason":{"type":"string"}},"additionalProperties":true}]}},
        "proper_nouns": {"type": "array", "items": {"oneOf":[{"type":"string"},{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":1},"equivalents":{"type":"array","items":{"type":"string","minLength":1}},"authorized":{"type":"boolean"},"reason":{"type":"string"}},"additionalProperties":true}]}},
        "versions": {"type": "array", "items": {"oneOf":[{"type":"string"},{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":1},"equivalents":{"type":"array","items":{"type":"string","minLength":1}},"authorized":{"type":"boolean"},"reason":{"type":"string"}},"additionalProperties":true}]}},
        "numbers": {"type": "array", "items": {"oneOf":[{"type":"string"},{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":1},"equivalents":{"type":"array","items":{"type":"string","minLength":1}},"authorized":{"type":"boolean"},"reason":{"type":"string"}},"additionalProperties":true}]}}
      }
    }
  },
  "additionalProperties": true
}
