{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:migration-conflict-analyzer:analysis-report:2.0",
  "title": "Migration Conflict Analyzer Report",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_version",
    "analysis_id",
    "heuristic_set",
    "input_identity",
    "operations",
    "findings",
    "gates",
    "summary",
    "limitations",
    "analysis_receipt"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "analysis_version": {"const": "2.0.0"},
    "analysis_id": {"type": "string", "pattern": "^analysis-[0-9a-f]{24}$"},
    "heuristic_set": {
      "type": "object",
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {"const": "migration-conflict-analyzer"},
        "version": {"const": "2.0.0"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "input_identity": {
      "type": "object",
      "required": ["digest", "files", "generated_sql", "runtime_code"],
      "properties": {
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {"type": "array"},
        "generated_sql": {"type": "array"},
        "runtime_code": {"type": "array"}
      }
    },
    "operations": {"type": "array"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "severity", "confidence", "evidence_status", "gate", "hazard_type", "uncertainty"],
        "properties": {
          "id": {"type": "string", "pattern": "^mca:"},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_status": {"enum": ["observed", "derived", "inferred", "supplied", "blocked"]},
          "gate": {"enum": ["block", "review-required", "manual-review", "none"]},
          "uncertainty": {"type": "string", "minLength": 1}
        }
      }
    },
    "gates": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["total_findings", "by_severity", "decision", "decision_basis"],
      "properties": {
        "decision": {"enum": ["block", "changes-required", "review-required", "no-static-blocker"]}
      }
    },
    "limitations": {"type": "array", "minItems": 1},
    "analysis_receipt": {
      "type": "object",
      "required": ["receipt_version", "status", "stage", "analysis_id", "analysis_core_sha256", "input_digest", "heuristic_set_sha256", "finding_ids"]
    }
  }
}
