{
  "set_name": "migration-conflict-analyzer",
  "version": "3.0.0",
  "severity_order": [
    "critical",
    "high",
    "medium",
    "low",
    "info"
  ],
  "confidence_levels": [
    "high",
    "medium",
    "low"
  ],
  "evidence_statuses": [
    "observed",
    "derived",
    "inferred",
    "supplied",
    "blocked"
  ],
  "gates": [
    "block",
    "review-required",
    "manual-review",
    "none"
  ],
  "rules": {
    "duplicate.add-column": {
      "severity": "critical",
      "confidence": "high",
      "gate": "block",
      "hazard_type": "schema-conflict",
      "title": "Duplicate AddColumn"
    },
    "duplicate.create-table": {
      "severity": "critical",
      "confidence": "high",
      "gate": "block",
      "hazard_type": "schema-conflict",
      "title": "Duplicate CreateTable"
    },
    "duplicate.object-name": {
      "severity": "critical",
      "confidence": "high",
      "gate": "block",
      "hazard_type": "schema-conflict",
      "title": "Duplicate database object name"
    },
    "history.duplicate-timestamp": {
      "severity": "low",
      "confidence": "medium",
      "gate": "manual-review",
      "hazard_type": "migration-history",
      "title": "Same migration timestamp signal"
    },
    "history.duplicate-full-id": {
      "severity": "critical",
      "confidence": "high",
      "gate": "block",
      "hazard_type": "migration-history",
      "title": "Duplicate full migration ID"
    },
    "history.duplicate-class": {
      "severity": "critical",
      "confidence": "high",
      "gate": "block",
      "hazard_type": "migration-history",
      "title": "Duplicate migration class"
    },
    "history.base-collision": {
      "severity": "critical",
      "confidence": "high",
      "gate": "block",
      "hazard_type": "branch-divergence",
      "title": "Changed migration collides with base history"
    },
    "history.diverged-lineage": {
      "severity": "critical",
      "confidence": "high",
      "gate": "block",
      "hazard_type": "branch-divergence",
      "title": "Migration lineage diverges from snapshot parent"
    },
    "destructive.drop-column": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "destructive-schema",
      "title": "DropColumn requires destructive-change review"
    },
    "destructive.drop-table": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "destructive-schema",
      "title": "DropTable requires destructive-change review"
    },
    "rename.drop-add": {
      "severity": "high",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "possible-data-loss",
      "title": "Drop/Add pattern may be an unsafe rename"
    },
    "conflict.index-definition": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "schema-conflict",
      "title": "Conflicting index definitions"
    },
    "conflict.foreign-key-definition": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "schema-conflict",
      "title": "Conflicting foreign-key definitions"
    },
    "ordering.after-drop": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "ordering",
      "title": "Later operation references a dropped object"
    },
    "ordering.rename": {
      "severity": "high",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "ordering",
      "title": "Rename has dependent operations"
    },
    "column.required-without-backfill": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "data-compatibility",
      "title": "Required column added without default or backfill evidence"
    },
    "column.nullability-tightening": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "data-compatibility",
      "title": "Nullable column becomes required"
    },
    "column.length-narrowing": {
      "severity": "medium",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "data-compatibility",
      "title": "Column maximum length is narrowed"
    },
    "column.precision-narrowing": {
      "severity": "medium",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "data-compatibility",
      "title": "Numeric precision or scale is narrowed"
    },
    "column.type-change": {
      "severity": "medium",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "data-compatibility",
      "title": "Column provider type changes"
    },
    "column.multiple-alter": {
      "severity": "medium",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "ordering",
      "title": "Multiple AlterColumn operations target the same column"
    },
    "data.structured-mutation": {
      "severity": "medium",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "data-migration",
      "title": "Structured EF data mutation"
    },
    "constraint.existing-data-validation": {
      "severity": "medium",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "data-compatibility",
      "title": "New constraint requires existing-data validation"
    },
    "index.unique-data-check": {
      "severity": "medium",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "data-compatibility",
      "title": "Unique index requires existing-data validation"
    },
    "raw-sql.non-idempotent-data": {
      "severity": "high",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "data-migration",
      "title": "Raw SQL appears non-idempotent on rerun"
    },
    "raw-sql.suppress-transaction": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "transaction",
      "title": "Raw SQL suppresses the migration transaction"
    },
    "raw-sql.opaque-mutation": {
      "severity": "medium",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "raw-sql",
      "title": "Raw SQL mutates schema or data"
    },
    "raw-sql.manual-review": {
      "severity": "low",
      "confidence": "low",
      "gate": "manual-review",
      "hazard_type": "raw-sql",
      "title": "Raw SQL requires manual interpretation"
    },
    "transaction.suppressed-command": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "transaction",
      "title": "Generated migration command suppresses the transaction"
    },
    "semantic.pending-model-changes": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "model-divergence",
      "title": "Semantic evidence reports pending model changes"
    },
    "runtime.startup-migrate": {
      "severity": "medium",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "runtime-deployment",
      "title": "Application startup applies migrations"
    },
    "runtime.concurrent-startup-version-unknown": {
      "severity": "medium",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "runtime-concurrency",
      "title": "Concurrent startup migration risk cannot be version-classified"
    },
    "runtime.concurrent-startup-unprotected": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "runtime-concurrency",
      "title": "Multiple startup migrators before EF9 locking"
    },
    "runtime.concurrent-startup-lock-aware": {
      "severity": "medium",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "runtime-concurrency",
      "title": "Multiple startup migrators on EF9+ lock-aware path"
    },
    "runtime.explicit-migrate-transaction": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "transaction",
      "title": "Migrate is wrapped in an explicit transaction"
    },
    "snapshot.divergence": {
      "severity": "medium",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "snapshot-divergence",
      "title": "Model snapshot and migration changes are not aligned"
    },
    "rollback.data-not-restorable": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "rollback",
      "title": "Rollback recreates dropped schema without proving data restoration"
    },
    "rollback.explicitly-unsupported": {
      "severity": "info",
      "confidence": "high",
      "gate": "none",
      "hazard_type": "rollback",
      "title": "Rollback is explicitly unsupported"
    },
    "determinism.runtime-dependent-migration": {
      "severity": "medium",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "determinism",
      "title": "Migration behavior depends on runtime state"
    },
    "provider.branch-incomplete": {
      "severity": "high",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "provider-compatibility",
      "title": "Provider-specific branch appears incomplete"
    },
    "provider.sqlite-rebuild-required": {
      "severity": "medium",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "provider-compatibility",
      "title": "SQLite operation may require table rebuild"
    },
    "provider.sqlite-idempotent-script-unsupported": {
      "severity": "critical",
      "confidence": "high",
      "gate": "block",
      "hazard_type": "provider-compatibility",
      "title": "SQLite idempotent migration scripts are unsupported"
    },
    "operational.ddl-locking-potential": {
      "severity": "medium",
      "confidence": "medium",
      "gate": "review-required",
      "hazard_type": "operational-locking",
      "title": "Generated DDL has blocking potential"
    },
    "artifact.review-execution-drift": {
      "severity": "critical",
      "confidence": "high",
      "gate": "block",
      "hazard_type": "artifact-integrity",
      "title": "Reviewed SQL differs from deployment SQL"
    },
    "artifact.generated-reviewed-drift": {
      "severity": "medium",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "artifact-integrity",
      "title": "Generated SQL differs from reviewed SQL"
    },
    "unknown.operation": {
      "severity": "low",
      "confidence": "low",
      "gate": "manual-review",
      "hazard_type": "parser-coverage",
      "title": "Unknown migrationBuilder operation"
    },
    "hotspot.same-table": {
      "severity": "low",
      "confidence": "medium",
      "gate": "manual-review",
      "hazard_type": "integration-hotspot",
      "title": "Multiple migrations touch the same table"
    },
    "structure.missing-up": {
      "severity": "high",
      "confidence": "high",
      "gate": "review-required",
      "hazard_type": "migration-structure",
      "title": "Migration has no Up body"
    },
    "structure.missing-down": {
      "severity": "low",
      "confidence": "high",
      "gate": "manual-review",
      "hazard_type": "rollback",
      "title": "Migration has no Down body"
    }
  }
}
