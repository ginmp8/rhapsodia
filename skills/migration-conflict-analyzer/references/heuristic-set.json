{
  "set_name": "migration-conflict-analyzer",
  "version": "2.0.0",
  "severity_order": ["critical", "high", "medium", "low", "info"],
  "confidence_levels": ["high", "medium", "low"],
  "evidence_statuses": ["observed", "derived", "inferred", "supplied", "blocked"],
  "gates": ["block", "review-required", "manual-review", "none"],
  "rules": {
    "duplicate.add-column": {"severity": "critical", "confidence": "high", "gate": "block", "hazard_type": "schema-conflict", "title": "Duplicate AddColumn"},
    "duplicate.create-table": {"severity": "critical", "confidence": "high", "gate": "block", "hazard_type": "schema-conflict", "title": "Duplicate CreateTable"},
    "duplicate.object-name": {"severity": "critical", "confidence": "high", "gate": "block", "hazard_type": "schema-conflict", "title": "Duplicate database object name"},
    "history.duplicate-timestamp": {"severity": "critical", "confidence": "high", "gate": "block", "hazard_type": "migration-history", "title": "Duplicate migration timestamp"},
    "history.duplicate-class": {"severity": "critical", "confidence": "high", "gate": "block", "hazard_type": "migration-history", "title": "Duplicate migration class"},
    "history.base-collision": {"severity": "critical", "confidence": "high", "gate": "block", "hazard_type": "branch-divergence", "title": "Changed migration collides with base history"},
    "destructive.drop-column": {"severity": "high", "confidence": "high", "gate": "review-required", "hazard_type": "destructive-schema", "title": "DropColumn requires destructive-change review"},
    "destructive.drop-table": {"severity": "high", "confidence": "high", "gate": "review-required", "hazard_type": "destructive-schema", "title": "DropTable requires destructive-change review"},
    "rename.drop-add": {"severity": "high", "confidence": "medium", "gate": "review-required", "hazard_type": "possible-data-loss", "title": "Drop/Add pattern may be an unsafe rename"},
    "conflict.index-definition": {"severity": "high", "confidence": "high", "gate": "review-required", "hazard_type": "schema-conflict", "title": "Conflicting index definitions"},
    "conflict.foreign-key-definition": {"severity": "high", "confidence": "high", "gate": "review-required", "hazard_type": "schema-conflict", "title": "Conflicting foreign-key definitions"},
    "ordering.after-drop": {"severity": "high", "confidence": "high", "gate": "review-required", "hazard_type": "ordering", "title": "Later operation references a dropped object"},
    "ordering.rename": {"severity": "high", "confidence": "medium", "gate": "review-required", "hazard_type": "ordering", "title": "Rename has dependent operations"},
    "column.required-without-backfill": {"severity": "high", "confidence": "high", "gate": "review-required", "hazard_type": "data-compatibility", "title": "Required column added without default or backfill evidence"},
    "raw-sql.non-idempotent-data": {"severity": "high", "confidence": "medium", "gate": "review-required", "hazard_type": "data-migration", "title": "Raw SQL appears non-idempotent on rerun"},
    "raw-sql.suppress-transaction": {"severity": "high", "confidence": "high", "gate": "review-required", "hazard_type": "transaction", "title": "Raw SQL suppresses the migration transaction"},
    "runtime.concurrent-startup-migrate": {"severity": "high", "confidence": "high", "gate": "review-required", "hazard_type": "runtime-concurrency", "title": "Startup migration is combined with multiple deployment instances"},
    "snapshot.divergence": {"severity": "medium", "confidence": "medium", "gate": "review-required", "hazard_type": "snapshot-divergence", "title": "Model snapshot and migration changes are not aligned"},
    "raw-sql.opaque-mutation": {"severity": "medium", "confidence": "medium", "gate": "review-required", "hazard_type": "raw-sql", "title": "Raw SQL mutates schema or data"},
    "column.multiple-alter": {"severity": "medium", "confidence": "medium", "gate": "review-required", "hazard_type": "ordering", "title": "Multiple AlterColumn operations target the same column"},
    "index.unique-data-check": {"severity": "medium", "confidence": "medium", "gate": "review-required", "hazard_type": "data-compatibility", "title": "Unique index requires existing-data validation"},
    "runtime.startup-migrate": {"severity": "medium", "confidence": "high", "gate": "review-required", "hazard_type": "runtime-deployment", "title": "Application startup applies migrations"},
    "unknown.operation": {"severity": "low", "confidence": "low", "gate": "manual-review", "hazard_type": "parser-coverage", "title": "Unknown migrationBuilder operation"},
    "raw-sql.manual-review": {"severity": "low", "confidence": "low", "gate": "manual-review", "hazard_type": "raw-sql", "title": "Raw SQL requires manual interpretation"},
    "hotspot.same-table": {"severity": "low", "confidence": "medium", "gate": "manual-review", "hazard_type": "integration-hotspot", "title": "Multiple migrations touch the same table"},
    "structure.missing-up": {"severity": "high", "confidence": "high", "gate": "review-required", "hazard_type": "migration-structure", "title": "Migration has no Up body"},
    "structure.missing-down": {"severity": "low", "confidence": "high", "gate": "manual-review", "hazard_type": "rollback", "title": "Migration has no Down body"}
  }
}
