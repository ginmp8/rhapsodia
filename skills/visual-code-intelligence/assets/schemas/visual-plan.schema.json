{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-code-intelligence/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "audience", "scope", "evidence", "claims", "signals", "visuals"],
  "properties": {
    "version": {"const": "visual-code-intelligence/1"},
    "mode": {"enum": ["change-review", "system-explanation", "code-archaeology", "visual-scratchpad"]},
    "audience": {"enum": ["overview", "technical", "deep-dive"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "base": {"type": ["string", "null"]},
        "head": {"type": ["string", "null"]}
      }
    },
    "changed_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "file_lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "paths"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["implementation", "tests", "docs", "generated-lock", "config-build", "fixtures-snapshots", "rename-move", "formatting", "imports"]},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]+$"},
          "kind": {"enum": ["source-code", "config-schema", "test", "runtime", "user-requirement", "current-spec", "current-doc", "diff", "issue", "pr", "commit", "trace", "other"]},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "classification", "statement", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^C[0-9]+$"},
          "kind": {"enum": ["current-behavior", "requested-intent", "rationale", "risk", "invariant"]},
          "classification": {"enum": ["observed", "historical", "inferred"]},
          "statement": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]+$"}, "uniqueItems": true}
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporal", "branching_retry", "state_lifecycle", "data_relationship", "component_dependency", "historical_sequence", "file_responsibilities"],
      "properties": {
        "explicit_visual": {"type": ["string", "null"], "enum": ["sequence", "flowchart", "state", "er", "architecture", "timeline", "change-map", "none", null]},
        "temporal": {"type": "boolean"},
        "branching_retry": {"type": "boolean"},
        "state_lifecycle": {"type": "boolean"},
        "data_relationship": {"type": "boolean"},
        "component_dependency": {"type": "boolean"},
        "historical_sequence": {"type": "boolean"},
        "file_responsibilities": {"type": "boolean"}
      }
    },
    "visuals": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "type"],
        "properties": {
          "role": {"enum": ["primary", "secondary"]},
          "type": {"enum": ["sequence", "flowchart", "state", "er", "architecture", "timeline", "change-map", "none"]}
        }
      }
    }
  }
}
