{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhapsodia.local/schemas/perceptual-review-result-v2.schema.json",
  "title": "Perceptual Review Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract","review_id","request_digest","reference_identity","candidate_identity","rubric_identity","gate_policy_identity","evaluator_protocol_identity","state_alignment","verdict","review_executed","trial_count","agreement","criteria_results","findings","supplemental_measurements","evidence_refs","uncertainty_reasons","limitations","recapture","policy_decision"],
  "properties": {
    "contract": {"const": "perceptual-review-result/v2"},
    "review_id": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference_identity": {"type": "string", "minLength": 1},
    "candidate_identity": {"type": "string", "minLength": 1},
    "rubric_identity": {"type": "string", "minLength": 1},
    "gate_policy_identity": {"type": "string", "minLength": 1},
    "evaluator_protocol_identity": {"type": "string", "minLength": 1},
    "state_alignment": {"enum": ["matched","mismatched","unknown"]},
    "verdict": {"enum": ["pass","fail","invalid","blocked","inconclusive"]},
    "review_executed": {"type": "boolean"},
    "trial_count": {"type": "integer", "minimum": 0},
    "agreement": {"enum": ["not-required","agreement","disagreement","unknown"]},
    "order_swap_performed": {"type": "boolean"},
    "criteria_results": {"type": "array", "items": {"$ref": "#/$defs/criterionResult"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "supplemental_measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "uncertainty_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recapture": {"$ref": "#/$defs/recapture"},
    "policy_decision": {"$ref": "#/$defs/policyDecision"}
  },
  "$defs": {
    "criterionResult": {
      "type": "object", "additionalProperties": false, "required": ["criterion_id","status","confidence","evidence_refs"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass","fail","inconclusive","not-reviewed"]},
        "confidence": {"enum": ["low","medium","high"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": {"enum": ["label","normalized-bbox","page","slide","component","selector","other"]},
        "label": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 0},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["region","criterion_id","category","difference","difference_type","perceptual_magnitude","impact_severity","confidence","evidence_refs"],
      "properties": {
        "region": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "criterion_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "difference": {"type": "string", "minLength": 1},
        "difference_type": {"enum": ["presence","text","move","resize","style","alignment","spacing","shape","encoding","relation","color","texture","other"]},
        "perceptual_magnitude": {"enum": ["tiny","small","medium","large"]},
        "impact_severity": {"enum": ["blocking","high","medium","low"]},
        "confidence": {"enum": ["low","medium","high"]},
        "uncertainty_reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["method","intended_property","scope","value","outcome","evidence_ref"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "intended_property": {"type": "string", "minLength": 1},
        "criterion_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "value": {"type": ["string","number","integer","boolean"]},
        "threshold": {"type": ["string","number","integer"]},
        "policy_identity": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["pass","fail","informational"]},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "recapture": {
      "type": "object", "additionalProperties": false, "required": ["required","reason"],
      "properties": {"required": {"type": "boolean"}, "reason": {"type": "string"}}
    },
    "policyDecision": {
      "type": "object", "additionalProperties": false, "required": ["outcome","reasons"],
      "properties": {
        "outcome": {"enum": ["pass","fail","invalid","blocked","inconclusive"]},
        "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
